{
  "name": "onegrc-platform",
  "version": "0.1.0",
  "private": true,
  "description": "OneGRC — unified governance, risk, compliance and audit platform",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:access": "pnpm --filter web check:access",
    "db:up": "docker compose --env-file .env -f docker/compose.dev.yml up -d db",
    "db:down": "docker compose --env-file .env -f docker/compose.dev.yml down",
    "db:logs": "docker compose --env-file .env -f docker/compose.dev.yml logs -f db",
    "prisma:generate": "pnpm --filter api prisma:generate"
  }
}
