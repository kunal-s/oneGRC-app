# Copy to .env . Never commit .env — it is gitignored.

# --- Database (consumed by docker/compose.dev.yml and by Prisma) ---
POSTGRES_USER=onegrc
POSTGRES_PASSWORD=onegrc_dev
POSTGRES_DB=onegrc
POSTGRES_PORT=5432
DATABASE_URL=postgresql://onegrc:onegrc_dev@localhost:5432/onegrc?schema=public

# --- API ---
API_PORT=3000

# --- Identity (ADR-002) ---
# dev  = impersonation endpoint sets the server identity context. The app
#        never redirects to an identity provider, so /dev/impersonate stays
#        reachable. SCR-096-031.
# oidc = federate to the customer identity provider. GAP-SCR-011-002, D-044
AUTH_MODE=dev

# The web origin the API redirects the browser back to after sign-in and
# sign-out. Same origin as the API behind a reverse proxy in production.
WEB_ORIGIN=http://localhost:5173

# --- Identity provider (GAP-SCR-011-002, D-044) ---
# Required only when AUTH_MODE=oidc.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=http://localhost:3000/api/auth/callback
# The claim in the identity provider's assertion that carries the subject.
# Resolved against Person.email, the platform's one credential-free join key.
OIDC_SUBJECT_CLAIM=email

# --- Document store (P0-14) ---
# Content-addressed blob storage. A Docker volume or mounted path on-prem.
DOCUMENT_STORE_PATH=./var/documents
