// OneGRC data model: spike slice (P0-03).
//
// Built to the ADRs, not to the prototype shapes. Standing constraints:
//
//   * NO DERIVED VALUE IS EVER STORED (BR-DRV-*, ADR-008). There is no `overdue`,
//     no `ageDays`, no `netLoss`, no `evidenceCount`, and no `department` on
//     anything but Person. A stored copy of a derivable fact is a future lie.
//   * Identifiers are <= 11 chars in the two shapes of ADR-003, allocated from
//     IdSequence inside the mutation transaction. Never reused.
//   * Every substantive record carries `title` and `shortTitle` (<= 60 chars).
//   * Every record carries `origin`, so sample data is purgeable as a set
//     (ADR-012) and ingested data is distinguishable from hand-entered.
//   * Deleting never orphans provenance (BR-LNK-10).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Where a record came from (D-018). `reference` ships with every install and
/// is never purgeable; `sample` is invented for demonstration and purgeable as
/// a set (ADR-012); `earned` is produced by the system doing its job or
/// ingested from a real source.
enum Origin {
  reference
  sample
  earned
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  shortName String   @db.VarChar(60)
  timezone  String   @default("Asia/Kolkata")
  locale    String   @default("en-IN")
  origin    Origin   @default(reference)
  createdAt DateTime @default(now())

  people  Person[]
  profile OrganisationProfile?
}

enum Department {
  ComplianceAndSecretarial
  Risk
  ITAndInformationSecurity
  InvestmentCompliance
  DataProtection
  FinanceAndTax
  HRAndLabour
  InternalAudit
}

enum LineOfDefence {
  First
  Second
  Third
}

enum PersonStatus {
  Active
  Away
  Invited
  Suspended
}

/// A named individual. NOT an account: authentication federates to the customer
/// IdP (ADR-002), so a Person carries no credentials. That is what makes sample
/// people safe: nobody can log in as one.
model Person {
  id             String        @id @default(cuid())
  organizationId String
  fullName       String
  jobTitle       String
  email          String?       @unique
  /// The one place department is stored. Every record derives its department
  /// from its owner (BR-SCP-01), so records must never carry their own.
  department     Department
  lineOfDefence  LineOfDefence
  status         PersonStatus  @default(Active)
  origin         Origin        @default(earned)
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  roles        PersonRole[]
  sessions     Session[]

  ownedControls      Control[]         @relation("ControlOwner")
  ownedObligations   Obligation[]      @relation("ObligationOwner")
  checkedObligations Obligation[]      @relation("ObligationChecker")
  ownedRisks         Risk[]            @relation("RiskOwner")
  assignedTasks      Task[]            @relation("TaskAssignee")
  checkedTasks       Task[]            @relation("TaskChecker")
  capturedEvidence   Evidence[]        @relation("EvidenceCapturedBy")
  verifiedEvidence   Evidence[]        @relation("EvidenceVerifiedBy")
  auditEntries       AuditEntry[]
  raisedFlags        ProvisionFlag[]   @relation("FlagRaisedBy")
  resolvedFlags      ProvisionFlag[]   @relation("FlagResolvedBy")
  ownedFlags         ProvisionFlag[]   @relation("FlagOwner")
  promotedProvisions SourceProvision[] @relation("ProvisionPromotedBy")
  decidedClauses     SourceClause[]    @relation("ClauseDecidedBy")
  notApplicableProvisions     SourceProvision[] @relation("ProvisionNotApplicableBy")
  specialistEngagedProvisions SourceProvision[] @relation("ProvisionSpecialistEngagedBy")

  @@index([organizationId, department])
  @@index([origin])
}

/// A platform capability set (spec 4.4). Reference data: ships with every
/// install and is never purgeable (D-018).
model Role {
  code        String @id @db.VarChar(24)
  name        String
  description String
  origin      Origin @default(reference)

  people      PersonRole[]
  authorities ActionAuthority[]
}

/// Person to Role is many-to-many: a real user holds several roles (spec 4.3).
model PersonRole {
  personId String
  roleCode String

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleCode], references: [code])

  @@id([personId, roleCode])
}

/// The action-authority matrix of spec 4.10, as DATA rather than code. One row
/// per permitted (action, role). Authority scattered across screens as ad-hoc
/// role comparisons is the failure BR-AUT-01 names.
model ActionAuthority {
  action             String      @db.VarChar(48)
  roleCode           String      @db.VarChar(24)
  /// The actor may not be the person who made the item (BR-AUT-05).
  separationOfDuties Boolean     @default(false)
  /// Where authority is gated by department rather than role (BR-AUT-02):
  /// clause decisions belong to Compliance and Company Secretarial alone.
  requiresDepartment Department?
  /// A line barred from checking this action (BR-AUT-10, AUTH-G1, D-047).
  /// Empty for every action in the first release: the column exists so the
  /// gate reads it, but nothing configures it yet.
  requiresLineOfDefence LineOfDefence?
  /// Reference data: the matrix ships with every install and is never
  /// purgeable, and can hold no other value (D-018).
  origin             Origin      @default(reference)

  role Role @relation(fields: [roleCode], references: [code])

  @@id([action, roleCode])
  @@index([action])
}

/// A stored file, addressed by content. The bytes live in the document store,
/// never in the database (P0-14). One store serves instruments and evidence.
model Document {
  sha256    String   @id @db.VarChar(64)
  byteSize  Int
  mimeType  String
  pageCount Int?
  origin    Origin   @default(earned)
  storedAt  DateTime @default(now())

  instruments Instrument[]
  evidence    Evidence[]
}

enum InstrumentType {
  Act
  Rules
  Regulation
  MasterCircular
  Circular
  Notification
  Direction
  Guidelines
  Standard
  Policy
}

enum InstrumentStatus {
  InForce
  Draft
  Superseded
  Repealed
}

/// How the document was obtained. Recorded because it matters: official sources
/// are frequently unfetchable, so manual upload is co-equal (spec 5.2).
enum RetrievalMethod {
  fetched
  manualUpload
}

enum TextLayer {
  native
  ocr
  none
}

/// A legal instrument. Provenance is first-class: the checksum is what lets the
/// firm prove an extracted clause came from this exact file (spec 5.1, G-14).
model Instrument {
  id            String           @id @db.VarChar(11)
  title         String
  shortTitle    String           @db.VarChar(60)
  /// What a lawyer quotes, e.g. Mah. XVI of 1975. Kept out of the id (ADR-003).
  citation      String?
  authority     String
  jurisdiction  String           @db.VarChar(8)
  type          InstrumentType
  issuedOn      DateTime?        @db.Date
  effectiveFrom DateTime?        @db.Date
  status        InstrumentStatus @default(InForce)

  documentSha256  String?
  sourceUrl       String?
  retrievedAt     DateTime?
  retrievalMethod RetrievalMethod?
  textLayer       TextLayer        @default(native)

  origin    Origin   @default(earned)
  createdAt DateTime @default(now())

  document      Document?            @relation(fields: [documentSha256], references: [sha256])
  clauses       SourceClause[]
  provisions    SourceProvision[]
  relationsFrom InstrumentRelation[] @relation("RelationFrom")
  relationsTo   InstrumentRelation[] @relation("RelationTo")

  @@index([status])
  @@index([origin])
}

enum InstrumentRelationKind {
  madeUnder
  references
  supersedes
  amends
}

/// How instruments relate. The PT Rules are madeUnder the PT Act; a circular
/// supersedes its predecessor and references a section of its parent Act.
model InstrumentRelation {
  id     String                 @id @default(cuid())
  fromId String                 @db.VarChar(11)
  toId   String                 @db.VarChar(11)
  kind   InstrumentRelationKind
  note   String?
  origin Origin                 @default(earned)

  from Instrument @relation("RelationFrom", fields: [fromId], references: [id])
  to   Instrument @relation("RelationTo", fields: [toId], references: [id])

  @@unique([fromId, toId, kind])
  @@index([toId])
}

/// The lifecycle of a clause (spec 7.3). Processing is the extraction state;
/// Recommended means a decision is owed; the other three are decided states,
/// each recorded with an actor, a timestamp and a basis.
enum ClauseState {
  Processing
  Recommended
  Saved
  SpecialistReview
  NotApplicable
}

enum ExtractionMethod {
  structural
  model
  manual
}

/// One provision within an instrument, the atomic unit the product manages.
/// A TRACKED clause: a provision a person has promoted because it binds the
/// firm. This table holds only qualified records, so the register, the queue
/// and every count are clean by construction rather than by filtering.
///
/// It SNAPSHOTS the text it was decided on. A decision is bound to the words
/// in force when it was taken; re-ingesting a superseded instrument must not
/// silently rewrite the basis of a past decision (spec 5.1).
model SourceClause {
  id           String  @id @db.VarChar(11)
  /// Lineage back to the extracted provision this was promoted from.
  provisionId  String  @unique
  /// SHA-256 of the verbatim text this decision was taken on. The clause
  /// freezes its words; the provision keeps following the document. This is
  /// the tripwire that makes divergence detectable rather than silent.
  textHash      String?   @db.VarChar(64)
  /// Set when re-extraction finds the source text no longer matches the
  /// snapshot. The decision stands, but its basis must be re-read.
  textDriftedAt DateTime?
  instrumentId String  @db.VarChar(11)
  /// The citation within the instrument, e.g. 6(2) or r.11(a).
  clauseRef    String  @db.VarChar(32)
  parentId     String? @db.VarChar(11)
  ordinal      Int
  title        String
  shortTitle   String  @db.VarChar(60)
  /// The exact extract. Never paraphrased: an auditor tests the artifact.
  verbatimText String
  /// Where it sits in the source document, so the app can open the PDF there.
  pageNumber   Int?
  charStart    Int?
  charEnd      Int?

  state                ClauseState      @default(Processing)
  extractionMethod     ExtractionMethod @default(structural)
  /// 0..1. Stored because the PT Rules are an OCR scan: confidence is a fact
  /// about this clause, not an assumption about the corpus.
  extractionConfidence Float?

  decidedAt     DateTime?
  decidedById   String?
  decisionBasis String?

  origin    Origin   @default(earned)
  createdAt DateTime @default(now())

  instrument Instrument     @relation(fields: [instrumentId], references: [id])
  parent     SourceClause?  @relation("ClauseHierarchy", fields: [parentId], references: [id])
  children   SourceClause[] @relation("ClauseHierarchy")
  /// A decision's actor may never be orphaned by deleting them (BR-LNK-10).
  decidedBy  Person?        @relation("ClauseDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  provision    SourceProvision @relation(fields: [provisionId], references: [id])
  linksFrom    ClauseLink[]    @relation("LinkFrom")
  linksTo      ClauseLink[]    @relation("LinkTo")
  penaltyTiers PenaltyTier[]
  controls     ControlClause[]
  obligations  Obligation[]

  @@unique([instrumentId, clauseRef])
  @@index([state])
  @@index([instrumentId, ordinal])
}

/// Why a clause needs a human eye. Every kind below is detectable without a
/// model, and every one has a real instance in the fixture set (P0-16).
enum ClauseFlagKind {
  /// "as may be prescribed": PT Act s.6 defers its cadence to the Rules.
  CadenceUnspecified
  /// Applicability turns on a fact about the firm, PT Rules r.11 liability.
  ConditionalApplicability
  /// Cites an instrument or section not yet ingested.
  UnresolvedCrossReference
  /// Square-bracket substitutions: the text has been amended.
  AmendedText
  ProvisoPresent
  /// may versus shall: a discretion, not a duty.
  DiscretionaryLanguage
  /// The source is an OCR scan and the text may be unreliable.
  LowExtractionConfidence
}

enum FlagRaisedBy {
  system
  person
}

enum ClauseLinkKind {
  /// The target supplies what the source defers, PT Rules r.11 resolves s.6.
  resolves
  references
  amends
}

model ClauseLink {
  id     String         @id @default(cuid())
  fromId String         @db.VarChar(11)
  toId   String         @db.VarChar(11)
  kind   ClauseLinkKind
  note   String?
  origin Origin         @default(earned)

  from SourceClause @relation("LinkFrom", fields: [fromId], references: [id])
  to   SourceClause @relation("LinkTo", fields: [toId], references: [id])

  @@unique([fromId, toId, kind])
}

/// A sourced penalty tier. Severity is derived from these, not typed by hand
/// (spec 3, Requirement 6). PT Act s.6(3): 200 rupees within thirty days,
/// 1000 rupees otherwise.
model PenaltyTier {
  id          String  @id @default(cuid())
  clauseId    String  @db.VarChar(11)
  ordinal     Int
  description String
  /// Minor units, to avoid float money. Null where the penalty is not monetary.
  amountMinor BigInt?
  currency    String? @db.VarChar(3)
  perDay      Boolean @default(false)
  /// e.g. personal disqualification of officers.
  nonMonetary String?
  origin      Origin  @default(earned)

  clause SourceClause @relation(fields: [clauseId], references: [id], onDelete: Cascade)

  @@unique([clauseId, ordinal])
}

enum ControlType {
  Preventive
  Detective
}

enum ControlAutomation {
  CCM
  Manual
}

/// The measure that satisfies duties. One control satisfies many clauses across
/// many laws: map once, satisfy many.
model Control {
  id          String            @id @db.VarChar(11)
  title       String
  shortTitle  String            @db.VarChar(60)
  description String?
  ownerId     String
  type        ControlType       @default(Preventive)
  automation  ControlAutomation @default(Manual)
  origin      Origin            @default(earned)
  createdAt   DateTime          @default(now())

  owner Person @relation("ControlOwner", fields: [ownerId], references: [id])

  clauses       ControlClause[]
  frameworkRefs ControlFrameworkRef[]
  obligations   ObligationControl[]
  risks         RiskControl[]
  evidence      ControlEvidence[]

  @@index([ownerId])
  @@index([origin])
}

/// Clause to Control is many-to-many, the heart of map once, satisfy many.
model ControlClause {
  controlId String @db.VarChar(11)
  clauseId  String @db.VarChar(11)

  control Control      @relation(fields: [controlId], references: [id], onDelete: Cascade)
  clause  SourceClause @relation(fields: [clauseId], references: [id])

  @@id([controlId, clauseId])
  @@index([clauseId])
}

model ControlFrameworkRef {
  id        String @id @default(cuid())
  controlId String @db.VarChar(11)
  framework String @db.VarChar(32)
  ref       String @db.VarChar(48)

  control Control @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@unique([controlId, framework, ref])
}

enum Frequency {
  Weekly
  Fortnightly
  Monthly
  Quarterly
  HalfYearly
  Annual
  EventBased
  Continuous
}

/// The STANDING duty (ADR-004). Holds the cadence; the occurrences are cycles.
/// Regulatory change updates the duty, and future cycles inherit it while
/// history keeps the cadence it was performed under.
model Obligation {
  id                  String    @id @db.VarChar(11)
  title               String
  shortTitle          String    @db.VarChar(60)
  regulator           String    @db.VarChar(32)
  frequency           Frequency
  ownerId             String
  checkerId           String?
  /// What proof completes it. PT Act s.6(2) requires a treasury challan, so the
  /// requirement is quoted from the source rather than invented.
  evidenceRequirement String?
  /// Provenance: the clause this duty derives from (BR-LNK-02).
  sourceClauseId      String?   @db.VarChar(11)
  origin              Origin    @default(earned)
  createdAt           DateTime  @default(now())

  owner   Person  @relation("ObligationOwner", fields: [ownerId], references: [id])
  /// A checker nomination may never be orphaned by deleting them (BR-LNK-10).
  checker Person? @relation("ObligationChecker", fields: [checkerId], references: [id], onDelete: Restrict)
  sourceClause SourceClause?       @relation(fields: [sourceClauseId], references: [id])
  controls     ObligationControl[]
  cycles       ObligationCycle[]

  @@index([ownerId])
  @@index([origin])
}

/// Obligation to Control is MANY-TO-MANY (ADR-009): one control satisfies many
/// duties, and one duty may need several controls acting together.
model ObligationControl {
  obligationId String @db.VarChar(11)
  controlId    String @db.VarChar(11)

  obligation Obligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  control    Control    @relation(fields: [controlId], references: [id])

  @@id([obligationId, controlId])
  @@index([controlId])
}

/// Deliberately has no Overdue member. Overdue is DERIVED from dueDate and
/// state (BR-DRV-17): a stored Overdue drifts from the facts it describes.
enum CycleState {
  Due
  InReview
  Filed
}

/// One occurrence of a recurring duty (ADR-004). Id is dutyId.period, which
/// exceeds the 11-char cap by design and is never rendered inline.
model ObligationCycle {
  id           String     @id @db.VarChar(24)
  obligationId String     @db.VarChar(11)
  /// 2026Q1, 2026M03, 2026A ...
  period       String     @db.VarChar(8)
  dueDate      DateTime   @db.Date
  state        CycleState @default(Due)
  filedAt      DateTime?
  origin       Origin     @default(earned)

  obligation Obligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  tasks      Task[]

  @@unique([obligationId, period])
  @@index([dueDate, state])
}

/// How a task is completed (ADR-006). One state machine, four gates.
enum CompletionPolicy {
  simple
  acknowledge
  evidence
  makerChecker
}

/// Also has no Overdue member: derived, like the cycle.
enum TaskState {
  Open
  InProgress
  Submitted
  Returned
  Done
  Cancelled
}

/// The unit of work. One engine, used by obligation cycles now and by
/// remediation, campaigns, DSAR stages and attestations later.
model Task {
  id               String           @id @db.VarChar(11)
  title            String
  shortTitle       String           @db.VarChar(60)
  completionPolicy CompletionPolicy
  state            TaskState        @default(Open)
  assigneeId       String
  checkerId        String?
  dueDate          DateTime?        @db.Date
  cycleId          String?          @db.VarChar(24)
  submittedAt      DateTime?
  completedAt      DateTime?
  origin           Origin           @default(earned)
  createdAt        DateTime         @default(now())

  assignee Person @relation("TaskAssignee", fields: [assigneeId], references: [id])
  /// A checker nomination may never be orphaned by deleting them (BR-LNK-10).
  checker  Person? @relation("TaskChecker", fields: [checkerId], references: [id], onDelete: Restrict)
  cycle    ObligationCycle? @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  evidence TaskEvidence[]

  @@index([assigneeId, state])
  @@index([dueDate, state])
}

enum EvidenceKind {
  Screenshot
  Log
  ConfigExport
  Attestation
  FilingAck
  Minute
  Challan
  Other
}

/// Evidence is Submitted then Verified (spec 7.3). Auto-captured evidence is
/// still verified (BR-EVD-03): capture is not proof of correctness.
enum EvidenceState {
  Submitted
  Verified
}

/// The artifact that proves a duty was done. Generated text is never evidence
/// (BR-EVD-07): the artifact is the filing acknowledgement, the challan, the
/// committee minute, the thing an auditor would test.
model Evidence {
  id               String        @id @db.VarChar(11)
  title            String
  shortTitle       String        @db.VarChar(60)
  kind             EvidenceKind
  capturedAt       DateTime
  capturedById     String?
  /// Set instead of capturedById when a feed captured it (CCM auto-capture).
  capturedBySystem String?
  documentSha256   String?
  state            EvidenceState @default(Submitted)
  verifiedAt       DateTime?
  verifiedById     String?
  origin           Origin        @default(earned)
  createdAt        DateTime      @default(now())

  /// Who captured or verified evidence may never be orphaned by deleting them
  /// (BR-LNK-10).
  capturedBy Person?   @relation("EvidenceCapturedBy", fields: [capturedById], references: [id], onDelete: Restrict)
  verifiedBy Person?   @relation("EvidenceVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  document   Document? @relation(fields: [documentSha256], references: [sha256])

  tasks    TaskEvidence[]
  controls ControlEvidence[]

  @@index([state])
  @@index([origin])
}

/// Evidence is reachable from both the task and the control (spec 7.2).
model TaskEvidence {
  taskId     String @db.VarChar(11)
  evidenceId String @db.VarChar(11)

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id])

  @@id([taskId, evidenceId])
  @@index([evidenceId])
}

model ControlEvidence {
  controlId  String @db.VarChar(11)
  evidenceId String @db.VarChar(11)

  control  Control  @relation(fields: [controlId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id])

  @@id([controlId, evidenceId])
  @@index([evidenceId])
}

enum RiskDomain {
  IT
  Cyber
  Operational
  Investment
  Compliance
  ThirdParty
}

/// Minimal at P0-03: the consequence end of the chain. The full lifecycle,
/// indicators and appetite land in Phase 2. Note there is no stored score,
/// stage or trend: all derived (BR-DRV).
model Risk {
  id         String     @id @db.VarChar(11)
  title      String
  shortTitle String     @db.VarChar(60)
  domain     RiskDomain
  ownerId    String
  likelihood Int
  impact     Int
  origin     Origin     @default(earned)
  createdAt  DateTime   @default(now())

  owner    Person        @relation("RiskOwner", fields: [ownerId], references: [id])
  controls RiskControl[]

  @@index([ownerId])
}

model RiskControl {
  riskId    String @db.VarChar(11)
  controlId String @db.VarChar(11)

  risk    Risk    @relation(fields: [riskId], references: [id], onDelete: Cascade)
  control Control @relation(fields: [controlId], references: [id])

  @@id([riskId, controlId])
  @@index([controlId])
}

/// Monotonic identifier counters (ADR-003). Scope is the prefix for catalogue
/// ids, PREFIX:YYYY for event ids. The row is locked inside the caller
/// transaction, so an id from a rolled-back mutation cannot survive and two
/// concurrent mutations cannot collide.
model IdSequence {
  scope String @id @db.VarChar(16)
  value Int    @default(0)
}

/// Server-side session. Authentication itself federates to the customer IdP
/// (ADR-002); in dev an impersonation endpoint mints these directly.
model Session {
  id        String    @id @default(cuid())
  personId  String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([expiresAt])
}

/// One immutable line of the platform own trail (spec 16, BR-AUD-01/02).
///
/// Append-only and hash-chained: each entry hashes its own content together
/// with the previous entry hash, so any later edit or deletion breaks the chain
/// and is detectable. The write happens in the SAME TRANSACTION as the change
/// it records: a change that is not logged must not commit (spec 17.5).
///
/// For confidential modules the entry records the ACT, never the content
/// (BR-AUD-05): that a report was triaged and by whom, not the allegation.
model AuditEntry {
  id         String   @id @db.VarChar(11)
  /// Monotonic position in the chain. Gaps are themselves evidence of tampering.
  seq        BigInt   @unique
  at         DateTime @default(now())
  actorId    String?
  /// Null actor means a system event (a scheduler firing, a feed ingesting).
  actorLabel String?
  action     String   @db.VarChar(48)
  entityType String   @db.VarChar(32)
  entityId   String?  @db.VarChar(48)
  /// What changed. Never the substance of a confidential case.
  detail     Json?
  prevHash   String?  @db.VarChar(64)
  hash       String   @db.VarChar(64)

  /// Deleting a person may never change what the log says they did, and may
  /// never null actorId, which sits inside the entry hash (BR-LNK-10, D-041).
  actor Person? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([at])
  @@index([actorId])
}

/// A minimum retention period per data store, below which nothing may shorten
/// it, the Administrator included (AUD-09, BR-DAT-05, D-040). Laid now because
/// a floor cannot be applied backwards to data already deleted; nothing reads
/// it yet, because no deletion path exists anywhere in the platform. A null
/// `minimumYears` means no automatic purge path exists at all, which is
/// closed investigations' floor under D-040.
///
/// The database itself, not the application, refuses to shorten a floor or to
/// delete a row: see the trigger in this migration.
model RetentionFloor {
  /// 'audit_log', 'evidence' or 'closed_investigations' (D-040).
  storeKey     String   @id @db.VarChar(32)
  minimumYears Int?
  note         String
  origin       Origin   @default(reference)
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Extraction tier: every provision in the document
// ---------------------------------------------------------------------------

/// What a provision IS, as a compliance officer would read it.
///
/// A statute is mostly machinery. The duties are a minority, and only they
/// become tracked clauses; the rest is context that is kept, linked and
/// searchable but never enters a queue.
enum ProvisionClass {
  /// Binds someone to do or not do something. The only class promoted.
  Duty
  /// Who the instrument binds, thresholds, exemptions. Gates whether a duty
  /// is ours; promoted only when it gates one of our duties.
  Applicability
  /// Penalty, interest, prosecution. Attaches to the duty it punishes and
  /// feeds severity from the sourced consequence (Requirement 6).
  Consequence
  /// Interpretation of terms. Needed to read a duty correctly, never chased.
  Definition
  /// Powers of an authority, appeals, revision. A right or a process, not our
  /// duty, though exercising one can create a duty.
  PowerProcedure
  /// Constitution of authorities, delegation, funds.
  Machinery
  /// Amounts, slabs, schedules. Attaches to the duty that uses the number.
  RateSchedule
  /// Short title, commencement, repeal, savings.
  Housekeeping
  /// The classifier could not decide. Never auto-promoted.
  Unclassified
}

/// Whether a provision binds THIS organisation.
enum BindsUs {
  yes
  no
  /// The duty-bearer is ambiguous, or the org profile cannot answer it.
  undetermined
}

/// Everything extracted from an instrument.
///
/// This tier is the document, faithfully held: no workflow, no state machine,
/// no queue. Only a provision that qualifies is promoted into SourceClause,
/// which is what keeps the tracked register clean.
model SourceProvision {
  /// Internal. Deliberately NOT user-facing: a provision earns a citable
  /// SRC identifier only when it is promoted (ADR-003 identifiers are stable,
  /// so one is not issued before the thing it names is tracked).
  id           String  @id @default(cuid())
  instrumentId String  @db.VarChar(11)
  clauseRef    String  @db.VarChar(32)
  parentId     String?
  ordinal      Int
  heading      String
  /// The exact extract. Never paraphrased.
  verbatimText String
  pageNumber   Int?
  charStart    Int?
  charEnd      Int?

  classification       ProvisionClass @default(Unclassified)
  /// 0..1 on a scale shared by every classifier, so swapping the provider
  /// cannot silently change what gets promoted.
  classifierConfidence Float?
  /// Who the provision binds, in the words of the instrument.
  dutyBearer           String?
  bindsUs              BindsUs        @default(undetermined)
  /// The extracted signals: modality, bearer phrase, lexicon hits, heading
  /// class. Consumed by the rules today and by a model prompt later.
  features             Json?
  classifierName       String?        @db.VarChar(32)
  classifierVersion    String?        @db.VarChar(16)
  /// Hash of the ruleset or prompt that produced the classification, so a
  /// decision can be explained years later (spec 13, change H-03).
  classifierRuleset    String?        @db.VarChar(64)
  classifiedAt         DateTime?

  promotedAt   DateTime?
  promotedById String?
  /// A recorded negative decision: this provision does not bind the firm.
  /// It never commits without a reason (BR-LFC-09).
  notApplicableAt     DateTime?
  notApplicableById   String?
  notApplicableReason String?
  /// Routed to outside counsel. The engagement itself is out of scope for now
  /// (G-11), so this records that it was asked for and by whom.
  specialistEngagedAt   DateTime?
  specialistEngagedById String?

  origin    Origin   @default(earned)
  createdAt DateTime @default(now())

  instrument Instrument       @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  parent     SourceProvision? @relation("ProvisionTree", fields: [parentId], references: [id])
  children   SourceProvision[] @relation("ProvisionTree")
  /// Who promoted a provision may never be orphaned by deleting them
  /// (BR-LNK-10).
  promotedBy     Person?         @relation("ProvisionPromotedBy", fields: [promotedById], references: [id], onDelete: Restrict)
  /// Declared to keep this relation in the schema at all: the migration that
  /// added these two columns also added their FK constraints, which this file
  /// never modelled as relations. Left ON DELETE SET NULL, unchanged: neither
  /// field is one of the ten provenance keys this slice makes RESTRICT
  /// (S00-021), and widening that list is not this slice's call.
  notApplicableBy     Person?         @relation("ProvisionNotApplicableBy", fields: [notApplicableById], references: [id])
  specialistEngagedBy Person?         @relation("ProvisionSpecialistEngagedBy", fields: [specialistEngagedById], references: [id])
  flags          ProvisionFlag[]
  promotedClause SourceClause?

  @@unique([instrumentId, clauseRef])
  @@index([instrumentId, ordinal])
  @@index([classification, bindsUs])
}

/// A reason a provision needs a human eye, with a lifecycle rather than a
/// permanent badge.
///
/// Blocking flags PREVENT promotion: you cannot track a duty you cannot date,
/// whose applicability you cannot determine, or whose text you do not trust.
/// Informational flags travel with the clause as context.
model ProvisionFlag {
  id          String         @id @default(cuid())
  provisionId String
  kind        ClauseFlagKind
  detail      String?
  /// Set from the kind, not by the raiser, so it cannot be argued away.
  blocking    Boolean        @default(false)

  raisedBy   FlagRaisedBy @default(system)
  raisedById String?
  raisedAt   DateTime     @default(now())
  /// Who must clear it. Defaults to the compliance owner of the instrument.
  ownerId    String?
  /// When it is due. Escalation is wired to the ONE ladder at P1-08; this
  /// field exists now so the ladder has something to point at.
  dueBy      DateTime?

  resolvedAt            DateTime?
  resolvedById          String?
  resolution            FlagResolution?
  resolutionNote        String?
  /// For CadenceUnspecified and UnresolvedCrossReference: the provision that
  /// answered the question. PT Rules r.11 resolves the gap in PT Act s.6(1).
  resolvedByProvisionId String?

  origin Origin @default(earned)

  provision SourceProvision @relation(fields: [provisionId], references: [id], onDelete: Cascade)
  /// Who owns, raised or resolved a flag may never be orphaned by deleting
  /// them (BR-LNK-10).
  owner          Person? @relation("FlagOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  raisedByPerson Person? @relation("FlagRaisedBy", fields: [raisedById], references: [id], onDelete: Restrict)
  resolvedBy     Person? @relation("FlagResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([provisionId])
  @@index([resolvedAt, blocking])
  @@index([ownerId, resolvedAt])
}

enum FlagResolution {
  /// The question was answered, usually by linking the provision that answers it.
  Resolved
  /// Deliberately tolerated, with a recorded basis. Never silent.
  Accepted
}

/// What this organisation IS, which is what decides whether a duty binds it.
///
/// Without this you cannot distinguish "every employer shall" (ours) from
/// "the Authority shall" (not ours), which is why the PFRDA Act produced 303
/// provisions and no usable duties.
model OrganisationProfile {
  id             String   @id @default(cuid())
  organizationId String   @unique
  legalForm      String
  /// ISO-ish jurisdiction codes the firm operates in, e.g. IN, IN-MH.
  jurisdictions  String[]
  /// The capacities the firm acts in: employer, pensionFundManager,
  /// intermediary, dataFiduciary. A duty-bearer phrase is matched to these.
  capacities     String[]
  /// Registrations held, e.g. { "PT-MH": "27...", "PFRDA": "PFM/..." }.
  registrations  Json?
  /// Facts that answer conditional applicability, e.g. annual PT liability
  /// band, which decides monthly versus annual returns under PT Rules r.11.
  thresholds     Json?
  origin         Origin   @default(reference)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}
