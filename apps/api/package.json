{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "register:fixtures": "ts-node -P tsconfig.scripts.json scripts/register-fixtures.ts",
    "ingest": "ts-node -P tsconfig.scripts.json scripts/ingest.ts",
    "bootstrap": "ts-node -P tsconfig.scripts.json scripts/setup.ts",
    "verify:audit": "ts-node -P tsconfig.scripts.json scripts/verify-audit-chain.ts",
    "prove:governance": "ts-node -P tsconfig.scripts.json scripts/prove-governance.ts",
    "check:derived": "ts-node -P tsconfig.scripts.json scripts/verify-no-derived-columns.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-fastify": "^10.4.4",
    "@onegrc/domain": "workspace:*",
    "@prisma/client": "^5.20.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.11.10",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
